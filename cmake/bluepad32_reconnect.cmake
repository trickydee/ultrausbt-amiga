# Compile a patched build-tree copy; never mutate the pinned submodule.
set(bp32_le "${CMAKE_SOURCE_DIR}/bluepad32/src/components/bluepad32/bt/uni_bt_le.c")
set(bp32_patch "${CMAKE_SOURCE_DIR}/patches/bluepad32-bonded-directed-reconnect.patch")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${bp32_le}" "${bp32_patch}")
file(SHA256 "${bp32_le}" bp32_sha)
if(NOT bp32_sha STREQUAL "4aeb4c34be70f5cd98d043add0f5004d0b433e962f4529427890ad5fe41deaea")
    message(FATAL_ERROR "Bluepad32 LE source changed: review the bonded reconnect patch before building")
endif()
find_program(PATCH_EXECUTABLE patch REQUIRED)
set(bp32_patched "${CMAKE_CURRENT_BINARY_DIR}/ultrausbt_uni_bt_le.c")
execute_process(COMMAND "${PATCH_EXECUTABLE}" --batch --fuzz=0 -o "${bp32_patched}" "${bp32_le}" "${bp32_patch}"
    RESULT_VARIABLE patch_result OUTPUT_VARIABLE patch_output ERROR_VARIABLE patch_error)
if(NOT patch_result EQUAL 0)
    message(FATAL_ERROR "Bluepad32 reconnect patch failed: ${patch_output} ${patch_error}")
endif()
get_target_property(bp32_sources bluepad32 SOURCES)
set(bp32_replaced FALSE)
set(bp32_new_sources "")
foreach(bp32_source IN LISTS bp32_sources)
    if(bp32_source MATCHES "(^|/)bt/uni_bt_le\\.c$")
        list(APPEND bp32_new_sources "${bp32_patched}")
        set(bp32_replaced TRUE)
    else()
        list(APPEND bp32_new_sources "${bp32_source}")
    endif()
endforeach()
if(NOT bp32_replaced)
    message(FATAL_ERROR "Could not locate Bluepad32 LE source in target")
endif()
set_property(TARGET bluepad32 PROPERTY SOURCES "${bp32_new_sources}")
target_sources(bluepad32 PRIVATE "${CMAKE_SOURCE_DIR}/src/bluepad32_bonded_reconnect.c")
message(STATUS "Bluepad32: bonded directed reconnect patch enabled")
